+    @Test
+    void createGLAccount_sameExternalReferenceDifferentPayload_throwsConflict() {
+        final GLAccount existing = existingAccount("Loan Receivable", "1200", false, 1, 1);
+        when(glAccountRepository.findOneByExternalReference(EXTERNAL_REFERENCE)).thenReturn(Optional.of(existing));
+        // same reference, but the name differs from what's already stored
+        stubPayload("Loan Receivable RENAMED", "1200", false, 1, 1);
+
+        assertThrows(GLAccountExternalReferenceConflictException.class, () -> underTest.createGLAccount(command));
+        verify(glAccountRepository, never()).saveAndFlush(any());
+    }
+
+    @Test
+    void createGLAccount_blankExternalReference_skipsIdempotencyLookupEntirely() {
+        // No external_reference supplied at all (e.g. a plain, non-synced GL account) must not even query the
+        // repository for one -- confirms the new Part A branch is additive and doesn't affect accounts that don't
+        // use external_reference. Stubbed fully enough to let Fineract's pre-existing create path complete normally,
+        // rather than asserting around an unmocked downstream failure.
+        when(command.stringValueOfParameterNamed(GLAccountJsonInputParams.EXTERNAL_REFERENCE.getValue())).thenReturn(null);
+        when(command.longValueOfParameterNamed(GLAccountJsonInputParams.TYPE.getValue())).thenReturn(1L);
+        stubPayload("Bank", "1100", false, 1, 1);
+
+        final CommandProcessingResult result = underTest.createGLAccount(command);
+
+        assertEquals(100L, result.getCommandId());
+        verify(glAccountRepository, never()).findOneByExternalReference(any());
+        // called twice in the pre-existing create flow: once before generateHierarchy(), once after
+        verify(glAccountRepository, times(2)).saveAndFlush(any());
+    }
+}
