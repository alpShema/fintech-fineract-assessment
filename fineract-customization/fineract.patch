+package org.apache.fineract.accounting.glaccount.exception;
+
+import org.apache.fineract.infrastructure.core.exception.AbstractPlatformException;
+
+/**
+ * A {@link RuntimeException} thrown when a GL Account create request reuses an existing
+ * {@code external_reference} with a payload that does not match the previously synced account. Mapped to HTTP 409
+ * (Conflict) by {@link GLAccountExternalReferenceConflictExceptionMapper} -- distinct from
+ * {@link GLAccountDuplicateException} (which covers {@code gl_code} collisions and maps to 403), because this is a
+ * genuine idempotency-key conflict: the caller sent the same business key with different data, not a
+ * forbidden/unauthorized action.
+ */
+public class GLAccountExternalReferenceConflictException extends AbstractPlatformException {
+
+    public GLAccountExternalReferenceConflictException(final String externalReference) {
+        super("error.msg.glaccount.externalreference.conflict", "A GL Account with external_reference '" + externalReference
+                + "' already exists with a different payload than the one supplied");
+    }
+}
