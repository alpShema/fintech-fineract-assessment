+    private CommandProcessingResult handleExistingExternalReference(final GLAccount existing, final JsonCommand command,
+            final String externalReference) {
+        if (isSamePayload(existing, command)) {
+            return new CommandProcessingResultBuilder().withCommandId(command.commandId()).withEntityId(existing.getId()).build();
