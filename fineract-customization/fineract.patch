+package org.apache.fineract.integrationtests.accounting;
+
+import static io.restassured.RestAssured.given;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+
+import com.google.gson.Gson;
+import io.restassured.builder.RequestSpecBuilder;
+import io.restassured.builder.ResponseSpecBuilder;
+import io.restassured.http.ContentType;
+import io.restassured.response.Response;
+import io.restassured.specification.RequestSpecification;
+import io.restassured.specification.ResponseSpecification;
+import java.util.HashMap;
+import java.util.Map;
+import org.apache.fineract.integrationtests.common.Utils;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Part A integration test for Java requirement behaviors 2 and 3 ("same reference + identical payload returns the
+ * existing account" / "same reference + different payload is rejected with a conflict"). Run against a real,
+ * running, customized Fineract instance (see fineract-customization/Dockerfile) via REST, the same way every other
+ * test in this module works -- this genuinely exercises the HTTP layer, the CREATE_GLACCOUNT permission check, the
+ * command handler, the JPA entity, and the DB-level unique constraint end to end, rather than mocking any of it.
+ * Behavior 1 (external_reference persisted + unique) and behavior 4 (permission-protected) are implicit
+ * preconditions for both tests passing at all: a working create has to persist the reference for the identical-retry
+ * test to find it again, and an unauthenticated/unauthorized caller would never reach either assertion.
+ */
+public class GLAccountExternalReferenceIntegrationTest {
+
+    private static final String CREATE_GL_ACCOUNT_URL = "/fineract-provider/api/v1/glaccounts?" + Utils.TENANT_IDENTIFIER;
+
+    private RequestSpecification requestSpec;
+    private ResponseSpecification responseSpec;
+
+    @BeforeEach
+    public void setup() {
+        Utils.initializeRESTAssured();
+
+        this.requestSpec = new RequestSpecBuilder().setContentType(ContentType.JSON).build();
+        this.requestSpec.header("Authorization", "Basic " + Utils.loginIntoServerAndGetBase64EncodedAuthenticationKey());
+        this.responseSpec = new ResponseSpecBuilder().expectStatusCode(200).build();
+    }
+
+    private String glAccountPayload(final String externalReference, final String glCode, final String name) {
+        final Map<String, Object> payload = new HashMap<>();
+        payload.put("name", name);
+        payload.put("glCode", glCode);
+        payload.put("manualEntriesAllowed", true);
+        payload.put("type", 1); // ASSET
+        payload.put("usage", 1); // DETAIL
+        payload.put("externalReference", externalReference);
+        return new Gson().toJson(payload);
+    }
+
+    @Test
+    public void sameExternalReferenceAndIdenticalPayload_returnsExistingAccount_doesNotCreateDuplicate() {
+        final String externalReference = Utils.uniqueRandomStringGenerator("GL-EXT-", 8);
+        final String glCode = Utils.uniqueRandomStringGenerator("GLCODE-", 6);
+        final String payload = glAccountPayload(externalReference, glCode, "Loan Receivable");
+
+        final Integer firstId = Utils.performServerPost(requestSpec, responseSpec, CREATE_GL_ACCOUNT_URL, payload, "resourceId");
+        assertNotNull(firstId, "First create must succeed and return a resource id");
+
+        // Simulates the ERP sync resending the exact same sync request (e.g. after a timeout it never actually saw
+        // the first response for) -- must come back as the same account, not a second row.
+        final Integer secondId = Utils.performServerPost(requestSpec, responseSpec, CREATE_GL_ACCOUNT_URL, payload, "resourceId");
+
+        assertEquals(firstId, secondId,
+                "Resending the identical payload for the same external_reference must return the existing account, not create a duplicate");
+    }
+
+    @Test
+    public void sameExternalReferenceDifferentPayload_rejectedWithConflict() {
+        final String externalReference = Utils.uniqueRandomStringGenerator("GL-EXT-", 8);
+        final String glCode = Utils.uniqueRandomStringGenerator("GLCODE-", 6);
+        final String firstPayload = glAccountPayload(externalReference, glCode, "Loan Receivable");
+
+        final Integer firstId = Utils.performServerPost(requestSpec, responseSpec, CREATE_GL_ACCOUNT_URL, firstPayload, "resourceId");
+        assertNotNull(firstId, "First create must succeed and return a resource id");
+
+        // Same external_reference, but a different glCode this time -- a genuine conflicting reuse of the business
+        // key, which must be rejected rather than silently treated as either a duplicate-return or an update (sync
+        // is create-only).
+        final String conflictingPayload = glAccountPayload(externalReference, Utils.uniqueRandomStringGenerator("GLCODE-", 6),
+                "Loan Receivable");
+
+        // Bypassing Utils.performServerPost/responseSpec here deliberately: responseSpec asserts 200, which would
+        // fail the request before we ever get to check the status code ourselves.
+        final Response response = given().spec(requestSpec).body(conflictingPayload).when().post(CREATE_GL_ACCOUNT_URL).andReturn();
+
+        assertEquals(409, response.statusCode(),
+                "Reusing external_reference '" + externalReference + "' with a different payload must be rejected with 409 Conflict");
+    }
+}
