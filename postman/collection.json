{
  "info": {
    "name": "fintech-fineract-assessment",
    "description": "Phase 0 baseline checks against the customized Fineract container (unmodified pinned tag 1.10.0 until Part A lands). Uses the default seeded tenant + super-user.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{fineractUser}}", "type": "string" },
      { "key": "password", "value": "{{fineractPassword}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:8443/fineract-provider" },
    { "key": "tenantId", "value": "default" },
    { "key": "fineractUser", "value": "mifos" },
    { "key": "fineractPassword", "value": "password" },
    { "key": "glExternalRef", "value": "GL-TEST-1200" },
    { "key": "integrationServiceUser", "value": "integration-service" },
    { "key": "integrationServicePassword", "value": "IntegrationService!2024" },
    { "key": "integrationRoleId", "value": "3" },
    { "key": "clientUid", "value": "SME-POSTMAN-001" },
    { "key": "loanReference", "value": "LN-POSTMAN-001" },
    { "key": "clientId", "value": "" },
    { "key": "loanId", "value": "" },
    { "key": "mockErpBaseUrl", "value": "http://localhost:8001" },
    { "key": "txnExternalRef", "value": "TXN-POSTMAN-001" },
    { "key": "integrationServiceBaseUrl", "value": "http://localhost:8002" },
    { "key": "integrationServiceApiKey", "value": "integration-service-partner-key" },
    { "key": "intSvcClientUid", "value": "SME-INTSVC-001" },
    { "key": "intSvcLoanReference", "value": "LN-INTSVC-001" },
    { "key": "runSuffix", "value": "" },
    { "key": "todayDate", "value": "" },
    { "key": "todayDateLong", "value": "" },
    { "key": "glCodeSuffix", "value": "" },
    { "key": "mockErpDemoAccountCode", "value": "" },
    { "key": "mockErpDemoAccountRef", "value": "" },
    { "key": "intSvcClientRef", "value": "" },
    { "key": "intSvcLoanAppRef", "value": "" },
    { "key": "intSvcDisbRef", "value": "" },
    { "key": "intSvcDisbRetryRef", "value": "" },
    { "key": "intSvcRepayRef", "value": "" }
  ],
  "item": [
    {
      "name": "0. Setup",
      "description": "Run the one request in here FIRST, every time you start a fresh test pass -- especially after `docker compose down` + `up` without `-v` (the Postgres volume survives a plain `down`, so old clients/loans/GL accounts/journal entries from a previous run are still there and will collide on a duplicate external_reference/client_uid/glCode/account code if you reuse the same values). It regenerates every identifier and date this whole collection uses, so nothing below needs manual editing.",
      "item": [
        {
          "name": "Generate Fresh Test Data (RUN THIS FIRST)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const suffix = Date.now().toString();",
                  "const today = new Date();",
                  "const todayIso = today.toISOString().slice(0, 10);",
                  "const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];",
                  "const todayLong = String(today.getUTCDate()).padStart(2, '0') + ' ' + months[today.getUTCMonth()] + ' ' + today.getUTCFullYear();",
                  "",
                  "pm.collectionVariables.set('runSuffix', suffix);",
                  "pm.collectionVariables.set('todayDate', todayIso);",
                  "pm.collectionVariables.set('todayDateLong', todayLong);",
                  "",
                  "// Part A",
                  "pm.collectionVariables.set('glExternalRef', 'GL-TEST-' + suffix);",
                  "pm.collectionVariables.set('glCodeSuffix', suffix);",
                  "",
                  "// Part C+D",
                  "pm.collectionVariables.set('clientUid', 'SME-POSTMAN-' + suffix);",
                  "pm.collectionVariables.set('loanReference', 'LN-POSTMAN-' + suffix);",
                  "pm.collectionVariables.set('clientId', '');",
                  "pm.collectionVariables.set('loanId', '');",
                  "",
                  "// Part G",
                  "pm.collectionVariables.set('txnExternalRef', 'TXN-POSTMAN-' + suffix);",
                  "pm.collectionVariables.set('mockErpDemoAccountCode', 'DEMO' + suffix.slice(-6));",
                  "pm.collectionVariables.set('mockErpDemoAccountRef', 'GL-DEMO-' + suffix);",
                  "",
                  "// Part E+F / Tier 2",
                  "pm.collectionVariables.set('intSvcClientUid', 'SME-INTSVC-' + suffix);",
                  "pm.collectionVariables.set('intSvcLoanReference', 'LN-INTSVC-' + suffix);",
                  "pm.collectionVariables.set('intSvcClientRef', 'REF-INTSVC-CLIENT-' + suffix);",
                  "pm.collectionVariables.set('intSvcLoanAppRef', 'REF-INTSVC-LOAN-' + suffix);",
                  "pm.collectionVariables.set('intSvcDisbRef', 'REF-INTSVC-DISB-' + suffix);",
                  "pm.collectionVariables.set('intSvcDisbRetryRef', 'REF-INTSVC-DISB-' + suffix + '-RETRY');",
                  "pm.collectionVariables.set('intSvcRepayRef', 'REF-INTSVC-REPAY-' + suffix);",
                  "",
                  "console.log('Fresh test data generated -- suffix=' + suffix + ', todayDate=' + todayIso);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] },
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "Actuator",
      "item": [
        {
          "name": "Health (no auth)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Info (no auth)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/info",
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "Baseline API checks",
      "item": [
        {
          "name": "List Offices",
          "request": {
            "method": "GET",
            "header": [{ "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/offices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "offices"]
            }
          }
        },
        {
          "name": "List GL Accounts (empty until Part A)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/glaccounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "glaccounts"]
            }
          }
        },
        {
          "name": "List Currencies",
          "request": {
            "method": "GET",
            "header": [{ "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/currencies",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "currencies"]
            }
          }
        },
        {
          "name": "List Clients (empty)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/clients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "clients"]
            }
          }
        }
      ]
    },
    {
      "name": "Part A - GL Account external_reference sync",
      "description": "Run these in order. 1 creates a new GL account; 2 resends the identical payload (expect HTTP 200, same resourceId, no duplicate); 3 reuses the same external_reference with a different payload (expect HTTP 409 Conflict). Change {{glExternalRef}} and the glCode in the body if you want to start fresh rather than hit the already-synced account from a previous run.",
      "item": [
        {
          "name": "1. Create GL Account (new external_reference)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/glaccounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "glaccounts"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Loan Receivable\",\n  \"glCode\": \"1200-TEST-{{glCodeSuffix}}\",\n  \"type\": 1,\n  \"usage\": 1,\n  \"manualEntriesAllowed\": true,\n  \"externalReference\": \"{{glExternalRef}}\"\n}"
            }
          }
        },
        {
          "name": "2. Resend IDENTICAL payload (expect 200, same resourceId)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/glaccounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "glaccounts"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Loan Receivable\",\n  \"glCode\": \"1200-TEST-{{glCodeSuffix}}\",\n  \"type\": 1,\n  \"usage\": 1,\n  \"manualEntriesAllowed\": true,\n  \"externalReference\": \"{{glExternalRef}}\"\n}"
            }
          }
        },
        {
          "name": "3. Resend SAME reference, DIFFERENT payload (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/glaccounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "glaccounts"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Loan Receivable CHANGED\",\n  \"glCode\": \"1200-TEST-{{glCodeSuffix}}-CONFLICT\",\n  \"type\": 1,\n  \"usage\": 1,\n  \"manualEntriesAllowed\": true,\n  \"externalReference\": \"{{glExternalRef}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Part B - Environment setup",
      "description": "Verify what scripts/setup-fineract-environment.sh created, then prove the least-privilege API user actually is least-privilege (both directions).",
      "item": [
        {
          "name": "1. List Offices (expect Head Office + Kigali Main Office)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/offices", "host": ["{{baseUrl}}"], "path": ["api", "v1", "offices"] }
          }
        },
        {
          "name": "1b. List Users (expect mifos + integration-service)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/users", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users"] }
          }
        },
        {
          "name": "2. List Loan Products (expect SME Asset Finance)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/loanproducts", "host": ["{{baseUrl}}"], "path": ["api", "v1", "loanproducts"] }
          }
        },
        {
          "name": "3. Check Role Permissions (expect exactly 10 selected)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/roles/{{integrationRoleId}}/permissions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "roles", "{{integrationRoleId}}", "permissions"]
            }
          }
        },
        {
          "name": "4. As integration-service: List Clients (expect 200, granted)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/clients", "host": ["{{baseUrl}}"], "path": ["api", "v1", "clients"] },
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{integrationServiceUser}}", "type": "string" },
                { "key": "password", "value": "{{integrationServicePassword}}", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "5. As integration-service: Create User (expect 403, NOT granted)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/users", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"should-fail\",\n  \"firstname\": \"x\",\n  \"lastname\": \"y\",\n  \"officeId\": 1,\n  \"roles\": [1],\n  \"sendPasswordToEmail\": false,\n  \"password\": \"Test1234!\",\n  \"repeatPassword\": \"Test1234!\"\n}"
            },
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{integrationServiceUser}}", "type": "string" },
                { "key": "password", "value": "{{integrationServicePassword}}", "type": "string" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Part C+D - Identities and Loan Lifecycle",
      "description": "Run in order. Each create step auto-captures its id into a collection variable (clientId, loanId) so later steps don't need manual copy-paste. Change {{clientUid}}/{{loanReference}} first if you want a fresh run instead of re-using a previous one.",
      "item": [
        {
          "name": "1. Create Client (client_uid as externalId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.resourceId) { pm.collectionVariables.set('clientId', json.resourceId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/clients", "host": ["{{baseUrl}}"], "path": ["api", "v1", "clients"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"officeId\": 2,\n  \"firstname\": \"Amina\",\n  \"lastname\": \"Uwase\",\n  \"externalId\": \"{{clientUid}}\",\n  \"legalFormId\": 1,\n  \"active\": true,\n  \"activationDate\": \"01 January 2026\",\n  \"dateFormat\": \"dd MMMM yyyy\",\n  \"locale\": \"en\"\n}"
            }
          }
        },
        {
          "name": "2. Find Client by client_uid (expect Active, correct name)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/clients/external-id/{{clientUid}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "clients", "external-id", "{{clientUid}}"]
            }
          }
        },
        {
          "name": "3. Create Loan Application (loan_reference as externalId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.resourceId) { pm.collectionVariables.set('loanId', json.resourceId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/loans", "host": ["{{baseUrl}}"], "path": ["api", "v1", "loans"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": {{clientId}},\n  \"productId\": 1,\n  \"loanType\": \"individual\",\n  \"principal\": 5000000,\n  \"loanTermFrequency\": 12,\n  \"loanTermFrequencyType\": 2,\n  \"numberOfRepayments\": 12,\n  \"repaymentEvery\": 1,\n  \"repaymentFrequencyType\": 2,\n  \"interestRatePerPeriod\": 18,\n  \"interestType\": 0,\n  \"amortizationType\": 1,\n  \"interestCalculationPeriodType\": 1,\n  \"transactionProcessingStrategyCode\": \"mifos-standard-strategy\",\n  \"expectedDisbursementDate\": \"15 January 2026\",\n  \"submittedOnDate\": \"15 January 2026\",\n  \"externalId\": \"{{loanReference}}\",\n  \"dateFormat\": \"dd MMMM yyyy\",\n  \"locale\": \"en\"\n}"
            }
          }
        },
        {
          "name": "4. Approve Loan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/loans/{{loanId}}?command=approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "loans", "{{loanId}}"],
              "query": [{ "key": "command", "value": "approve" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approvedOnDate\": \"15 January 2026\",\n  \"expectedDisbursementDate\": \"15 January 2026\",\n  \"dateFormat\": \"dd MMMM yyyy\",\n  \"locale\": \"en\"\n}"
            }
          }
        },
        {
          "name": "5. Disburse Loan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/loans/{{loanId}}?command=disburse",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "loans", "{{loanId}}"],
              "query": [{ "key": "command", "value": "disburse" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actualDisbursementDate\": \"15 January 2026\",\n  \"dateFormat\": \"dd MMMM yyyy\",\n  \"locale\": \"en\"\n}"
            }
          }
        },
        {
          "name": "6. Repayment 1 of 3 (458400 RWF)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/loans/{{loanId}}/transactions?command=repayment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "loans", "{{loanId}}", "transactions"],
              "query": [{ "key": "command", "value": "repayment" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionDate\": \"15 February 2026\",\n  \"transactionAmount\": 458400,\n  \"dateFormat\": \"dd MMMM yyyy\",\n  \"locale\": \"en\"\n}"
            }
          }
        },
        {
          "name": "7. Repayment 2 of 3 (458400 RWF)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/loans/{{loanId}}/transactions?command=repayment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "loans", "{{loanId}}", "transactions"],
              "query": [{ "key": "command", "value": "repayment" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionDate\": \"15 March 2026\",\n  \"transactionAmount\": 458400,\n  \"dateFormat\": \"dd MMMM yyyy\",\n  \"locale\": \"en\"\n}"
            }
          }
        },
        {
          "name": "8. Repayment 3 of 3 (458400 RWF)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/loans/{{loanId}}/transactions?command=repayment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "loans", "{{loanId}}", "transactions"],
              "query": [{ "key": "command", "value": "repayment" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionDate\": \"15 April 2026\",\n  \"transactionAmount\": 458400,\n  \"dateFormat\": \"dd MMMM yyyy\",\n  \"locale\": \"en\"\n}"
            }
          }
        },
        {
          "name": "9. Check Balance (auto-captures payoff amount)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('finalPayoffAmount', json.summary.totalOutstanding);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/loans/{{loanId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "loans", "{{loanId}}"] }
          }
        },
        {
          "name": "10. Final Payoff (expect status -> Closed (obligations met))",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/loans/{{loanId}}/transactions?command=repayment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "loans", "{{loanId}}", "transactions"],
              "query": [{ "key": "command", "value": "repayment" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionDate\": \"20 April 2026\",\n  \"transactionAmount\": {{finalPayoffAmount}},\n  \"dateFormat\": \"dd MMMM yyyy\",\n  \"locale\": \"en\"\n}"
            }
          }
        },
        {
          "name": "11. Find Loan by loan_reference (expect Closed, chains to client_uid)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/loans/external-id/{{loanReference}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "loans", "external-id", "{{loanReference}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Part G - Mock ERP",
      "description": "Mock ERP runs on a separate base URL ({{mockErpBaseUrl}}) with no authentication (unlike Fineract). Seeded chart of accounts (1100 Bank, 1200 Loan Receivable, 4000 Interest Income) matches Fineract's Part B GL accounts exactly, same codes and external_reference values.",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "0. Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{mockErpBaseUrl}}/health", "host": ["{{mockErpBaseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "1. List Accounts (expect seeded 1100/1200/4000)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{mockErpBaseUrl}}/api/accounts", "host": ["{{mockErpBaseUrl}}"], "path": ["api", "accounts"] }
          }
        },
        {
          "name": "2. Create Account (new external_reference)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{mockErpBaseUrl}}/api/accounts", "host": ["{{mockErpBaseUrl}}"], "path": ["api", "accounts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{mockErpDemoAccountCode}}\",\n  \"name\": \"Loan Losses Written Off\",\n  \"type\": \"EXPENSE\",\n  \"currency\": \"RWF\",\n  \"external_reference\": \"{{mockErpDemoAccountRef}}\"\n}"
            }
          }
        },
        {
          "name": "3. Resend IDENTICAL payload (expect 200, same id)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{mockErpBaseUrl}}/api/accounts", "host": ["{{mockErpBaseUrl}}"], "path": ["api", "accounts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{mockErpDemoAccountCode}}\",\n  \"name\": \"Loan Losses Written Off\",\n  \"type\": \"EXPENSE\",\n  \"currency\": \"RWF\",\n  \"external_reference\": \"{{mockErpDemoAccountRef}}\"\n}"
            }
          }
        },
        {
          "name": "4. Resend SAME reference, DIFFERENT payload (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{mockErpBaseUrl}}/api/accounts", "host": ["{{mockErpBaseUrl}}"], "path": ["api", "accounts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{mockErpDemoAccountCode}}-X\",\n  \"name\": \"Renamed\",\n  \"type\": \"EXPENSE\",\n  \"currency\": \"RWF\",\n  \"external_reference\": \"{{mockErpDemoAccountRef}}\"\n}"
            }
          }
        },
        {
          "name": "5. Create Journal Entry (balanced: disbursement)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{mockErpBaseUrl}}/api/journal-entries", "host": ["{{mockErpBaseUrl}}"], "path": ["api", "journal-entries"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"{{txnExternalRef}}\",\n  \"entry_date\": \"2026-01-15\",\n  \"description\": \"demo disbursement\",\n  \"lines\": [\n    {\"account_code\": \"1200\", \"debit\": \"5000000.00\"},\n    {\"account_code\": \"1100\", \"credit\": \"5000000.00\"}\n  ]\n}"
            }
          }
        },
        {
          "name": "6. Resend IDENTICAL entry (expect 200, same id)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{mockErpBaseUrl}}/api/journal-entries", "host": ["{{mockErpBaseUrl}}"], "path": ["api", "journal-entries"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"{{txnExternalRef}}\",\n  \"entry_date\": \"2026-01-15\",\n  \"description\": \"demo disbursement\",\n  \"lines\": [\n    {\"account_code\": \"1200\", \"debit\": \"5000000.00\"},\n    {\"account_code\": \"1100\", \"credit\": \"5000000.00\"}\n  ]\n}"
            }
          }
        },
        {
          "name": "7. Same reference, UNBALANCED different payload (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{mockErpBaseUrl}}/api/journal-entries", "host": ["{{mockErpBaseUrl}}"], "path": ["api", "journal-entries"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"{{txnExternalRef}}\",\n  \"entry_date\": \"2026-01-15\",\n  \"description\": \"CHANGED\",\n  \"lines\": [\n    {\"account_code\": \"1200\", \"debit\": \"1000000.00\"},\n    {\"account_code\": \"1100\", \"credit\": \"1000000.00\"}\n  ]\n}"
            }
          }
        },
        {
          "name": "8. Entry that does NOT balance (expect 422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{mockErpBaseUrl}}/api/journal-entries", "host": ["{{mockErpBaseUrl}}"], "path": ["api", "journal-entries"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"TXN-UNBALANCED-DEMO\",\n  \"entry_date\": \"2026-01-15\",\n  \"lines\": [\n    {\"account_code\": \"1200\", \"debit\": \"100.00\"},\n    {\"account_code\": \"1100\", \"credit\": \"50.00\"}\n  ]\n}"
            }
          }
