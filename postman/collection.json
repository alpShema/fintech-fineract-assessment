        {
          "name": "11. Check Balance: Bank (1100)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{mockErpBaseUrl}}/api/accounts/1100/balance",
              "host": ["{{mockErpBaseUrl}}"],
              "path": ["api", "accounts", "1100", "balance"]
            }
          }
        }
      ]
    },
    {
      "name": "Part E+F - Integration Service",
      "description": "Runs on its own base URL ({{integrationServiceBaseUrl}}), bridging Mock ERP and Fineract. Every write endpoint carries the external_reference idempotency contract (Part F): new reference -> process; same reference + identical payload -> replay the original result (always HTTP 200, even though the original create was 201); same reference + different payload -> 409. Run in order -- loan steps depend on the client created in step 3.",
      "auth": {
        "type": "apikey",
        "apikey": [
          { "key": "key", "value": "X-Api-Key", "type": "string" },
          { "key": "value", "value": "{{integrationServiceApiKey}}", "type": "string" },
          { "key": "in", "value": "header", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "0. Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{integrationServiceBaseUrl}}/health", "host": ["{{integrationServiceBaseUrl}}"], "path": ["health"] },
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "1. Sync All GL Accounts from Mock ERP (expect SYNCED)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/accounts/sync",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "accounts", "sync"]
            },
            "body": { "mode": "raw", "raw": "{}" },
            "description": "account_code is optional -- {} (empty body) syncs every account currently in the Mock ERP's chart of accounts. To sync just one, send {\"account_code\": \"1100\"} instead."
          }
        },
        {
          "name": "2. Resync (idempotent -- same accounts, no duplicate Fineract GL accounts)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/accounts/sync",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "accounts", "sync"]
            },
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "3. Create Client (client_uid as the stable business key)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/clients",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "clients"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"{{intSvcClientRef}}\",\n  \"client_uid\": \"{{intSvcClientUid}}\",\n  \"firstname\": \"Jean\",\n  \"lastname\": \"Mugisha\"\n}"
            }
          }
        },
        {
          "name": "4. Resend IDENTICAL Client Create (expect 200 replay, no new Fineract client)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/clients",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "clients"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"{{intSvcClientRef}}\",\n  \"client_uid\": \"{{intSvcClientUid}}\",\n  \"firstname\": \"Jean\",\n  \"lastname\": \"Mugisha\"\n}"
            }
          }
        },
        {
          "name": "5. Get Client by client_uid",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/clients/{{intSvcClientUid}}",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "clients", "{{intSvcClientUid}}"]
            }
          }
        },
        {
          "name": "6. Create Loan Application (auto-approves -- see DECISIONS.md)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{integrationServiceBaseUrl}}/api/loans", "host": ["{{integrationServiceBaseUrl}}"], "path": ["api", "loans"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"{{intSvcLoanAppRef}}\",\n  \"client_uid\": \"{{intSvcClientUid}}\",\n  \"loan_reference\": \"{{intSvcLoanReference}}\",\n  \"principal\": \"1000000\",\n  \"expected_disbursement_date\": \"{{todayDate}}\"\n}"
            }
          }
        },
        {
          "name": "7. Get Loan (expect Approved)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/loans/{{intSvcLoanReference}}",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "loans", "{{intSvcLoanReference}}"]
            }
          }
        },
        {
          "name": "8. Disburse Loan",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/loans/{{intSvcLoanReference}}/disburse",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "loans", "{{intSvcLoanReference}}", "disburse"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"{{intSvcDisbRef}}\",\n  \"actual_disbursement_date\": \"{{todayDate}}\"\n}"
            }
          }
        },
        {
          "name": "9. Re-disburse with a DIFFERENT external_reference (expect 200 replay, scope_key=loan keeps it to one Fineract disbursement)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/loans/{{intSvcLoanReference}}/disburse",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "loans", "{{intSvcLoanReference}}", "disburse"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"{{intSvcDisbRetryRef}}\",\n  \"actual_disbursement_date\": \"{{todayDate}}\"\n}"
            }
          }
        },
        {
          "name": "10. Repay Loan",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/loans/{{intSvcLoanReference}}/repayments",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "loans", "{{intSvcLoanReference}}", "repayments"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"{{intSvcRepayRef}}\",\n  \"transaction_date\": \"{{todayDate}}\",\n  \"transaction_amount\": \"100000\"\n}"
            }
          }
        },
        {
          "name": "11. Get Loan After Repayment (expect reduced outstanding)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/loans/{{intSvcLoanReference}}",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "loans", "{{intSvcLoanReference}}"]
            }
          }
        },
        {
          "name": "12. Get Transaction by external_reference (searches across all operation types)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/transactions/{{intSvcLoanAppRef}}",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "transactions", "{{intSvcLoanAppRef}}"]
            }
          }
        },
        {
          "name": "13. Reconciliation (see the Tier 2 folder for seeded examples)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/reconciliation",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "reconciliation"]
            },
            "body": { "mode": "raw", "raw": "{}" }
          }
        }
      ]
    },
    {
      "name": "Tier 2 - Reliability (Parts H-K)",
      "description": "Fault injection (Part J's 'build a way to inject failures on demand') and the reconciliation report (Part K). Run scripts/demo-part-j-failure-scenarios.sh and scripts/demo-part-k-reconciliation.sh for the full scripted walkthroughs -- these requests are for manual, ad-hoc exploration of the same admin surface.",
      "auth": {
        "type": "apikey",
        "apikey": [
          { "key": "key", "value": "X-Api-Key", "type": "string" },
          { "key": "value", "value": "{{integrationServiceApiKey}}", "type": "string" },
          { "key": "in", "value": "header", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "1. Arm Fault: Fineract down",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/admin/fault-injection",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "admin", "fault-injection"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target\": \"fineract_disburse\",\n  \"mode\": \"down\",\n  \"times\": 1\n}"
            }
          }
        },
        {
          "name": "1b. Arm Fault: ERP down after Fineract success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/admin/fault-injection",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "admin", "fault-injection"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target\": \"erp_journal_entry\",\n  \"mode\": \"down\",\n  \"times\": 1\n}"
            }
          }
        },
        {
          "name": "1c. Arm Fault: timeout after send (Fineract or ERP really processes it, we just don't see the response)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/admin/fault-injection",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "admin", "fault-injection"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target\": \"fineract_disburse\",\n  \"mode\": \"timeout_after_send\",\n  \"times\": 1\n}"
            }
          }
        },
        {
          "name": "2. Check Armed Faults",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/admin/fault-injection",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "admin", "fault-injection"]
            }
          }
        },
        {
          "name": "3. Clear All Armed Faults",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/admin/fault-injection",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "admin", "fault-injection"]
            }
          }
        },
        {
          "name": "4. Run Recovery Sweep (also runs automatically at app startup)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/admin/recover",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "admin", "recover"]
            }
          }
        },
        {
          "name": "5. Reconciliation Report (by date range -- expect MATCHED/MISSING_IN_ERP/MISSING_IN_FINERACT/AMOUNT_MISMATCH)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/reconciliation",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "reconciliation"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date_from\": \"{{todayDate}}\",\n  \"date_to\": \"{{todayDate}}\"\n}"
            }
          }
        },
        {
          "name": "5b. Reconciliation Report (scoped to specific external_references)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{integrationServiceBaseUrl}}/api/reconciliation",
              "host": ["{{integrationServiceBaseUrl}}"],
              "path": ["api", "reconciliation"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_references\": [\"{{intSvcLoanAppRef}}\", \"{{intSvcDisbRef}}\"]\n}"
            }
          }
        }
      ]
    }
  ]
}
