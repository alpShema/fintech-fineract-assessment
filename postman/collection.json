              "host": ["{{mockErpBaseUrl}}"],
              "path": ["api", "journal-entries", "{{txnExternalRef}}"]
            }
          }
        },
        {
          "name": "10. Check Balance: Loan Receivable (1200)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{mockErpBaseUrl}}/api/accounts/1200/balance",
              "host": ["{{mockErpBaseUrl}}"],
              "path": ["api", "accounts", "1200", "balance"]
