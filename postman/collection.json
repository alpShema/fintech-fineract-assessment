{
  "info": {
    "name": "fintech-fineract-assessment",
    "description": "Phase 0 baseline checks against the customized Fineract container (unmodified pinned tag 1.10.0 until Part A lands). Uses the default seeded tenant + super-user.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{fineractUser}}", "type": "string" },
      { "key": "password", "value": "{{fineractPassword}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:8443/fineract-provider" },
    { "key": "tenantId", "value": "default" },
    { "key": "fineractUser", "value": "mifos" },
    { "key": "fineractPassword", "value": "password" },
    { "key": "glExternalRef", "value": "GL-TEST-1200" }
  ],
  "item": [
    {
      "name": "Actuator",
      "item": [
        {
          "name": "Health (no auth)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Info (no auth)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/info",
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "Baseline API checks",
      "item": [
        {
          "name": "List Offices",
          "request": {
            "method": "GET",
            "header": [{ "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/offices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "offices"]
            }
          }
        },
        {
          "name": "List GL Accounts (empty until Part A)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/glaccounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "glaccounts"]
            }
          }
        },
        {
          "name": "List Currencies",
          "request": {
            "method": "GET",
            "header": [{ "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/currencies",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "currencies"]
            }
          }
        },
        {
          "name": "List Clients (empty)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/clients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "clients"]
            }
          }
        }
      ]
    },
    {
      "name": "Part A - GL Account external_reference sync",
      "description": "Run these in order. 1 creates a new GL account; 2 resends the identical payload (expect HTTP 200, same resourceId, no duplicate); 3 reuses the same external_reference with a different payload (expect HTTP 409 Conflict). Change {{glExternalRef}} and the glCode in the body if you want to start fresh rather than hit the already-synced account from a previous run.",
      "item": [
        {
          "name": "1. Create GL Account (new external_reference)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/glaccounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "glaccounts"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Loan Receivable\",\n  \"glCode\": \"1200-TEST\",\n  \"type\": 1,\n  \"usage\": 1,\n  \"manualEntriesAllowed\": true,\n  \"externalReference\": \"{{glExternalRef}}\"\n}"
            }
          }
        },
        {
          "name": "2. Resend IDENTICAL payload (expect 200, same resourceId)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/glaccounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "glaccounts"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Loan Receivable\",\n  \"glCode\": \"1200-TEST\",\n  \"type\": 1,\n  \"usage\": 1,\n  \"manualEntriesAllowed\": true,\n  \"externalReference\": \"{{glExternalRef}}\"\n}"
            }
          }
        },
        {
          "name": "3. Resend SAME reference, DIFFERENT payload (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Fineract-Platform-TenantId", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/glaccounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "glaccounts"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Loan Receivable CHANGED\",\n  \"glCode\": \"1200-TEST-CONFLICT\",\n  \"type\": 1,\n  \"usage\": 1,\n  \"manualEntriesAllowed\": true,\n  \"externalReference\": \"{{glExternalRef}}\"\n}"
            }
          }
        }
      ]
    }
  ]
}
